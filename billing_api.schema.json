{
  "title": "Banking Billing System API Schema",
  "oneOf": [
    {
      "$ref": "#/definitions/BillingOperationCreateRequest"
    },
    {
      "$ref": "#/definitions/BillingOperationPatchRequest"
    },
    {
      "$ref": "#/definitions/BillingOperationResponse"
    },
    {
      "$ref": "#/definitions/BillingOperationListResponse"
    },
    {
      "$ref": "#/definitions/ErrorResponse"
    }
  ],
  "definitions": {
    "BillingOperationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalOperationId",
        "clientId",
        "accountId",
        "operationType",
        "operationAmount",
        "operationCurrency",
        "operationDate"
      ],
      "properties": {
        "externalOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operationType": {
          "type": "string",
          "enum": [
            "TRANSFER",
            "PAYMENT",
            "CASH_WITHDRAWAL"
          ]
        },
        "operationAmount": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 999999999999.99,
          "multipleOf": 0.01
        },
        "operationCurrency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "operationDate": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "BillingOperationPatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferStatus"
      ],
      "properties": {
        "transferStatus": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        }
      }
    },
    "BillingOperationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "externalOperationId",
        "status",
        "billingDecision",
        "commissionAmount",
        "commissionCurrency",
        "chargeStatus",
        "_links"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "externalOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "CALCULATED",
            "REJECTED",
            "COMPLETED",
            "CANCELLED",
            "ERROR"
          ]
        },
        "billingDecision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "decisionReason": {
          "type": "string",
          "enum": [
            "INSUFFICIENT_FUNDS",
            "ACCOUNT_BLOCKED",
            "ACCOUNT_CLOSED",
            "TARIFF_NOT_FOUND"
          ]
        },
        "commissionAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 999999999999.99,
          "multipleOf": 0.01
        },
        "commissionCurrency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "chargeStatus": {
          "type": "string",
          "enum": [
            "NO_CHARGE",
            "RESERVED",
            "PAID",
            "NOT_CHARGED",
            "PAYMENT_ERROR"
          ]
        },
        "_links": {
          "$ref": "#/definitions/OperationLinks"
        }
      }
    },
    "OperationLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self"
      ],
      "properties": {
        "self": {
          "$ref": "#/definitions/Link"
        },
        "update": {
          "$ref": "#/definitions/Link"
        }
      }
    },
    "BillingOperationListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page",
        "size",
        "totalElements",
        "totalPages",
        "_links"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/BillingOperationResponse"
          }
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalElements": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        },
        "_links": {
          "$ref": "#/definitions/CollectionLinks"
        }
      }
    },
    "CollectionLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self"
      ],
      "properties": {
        "self": {
          "$ref": "#/definitions/Link"
        },
        "next": {
          "$ref": "#/definitions/Link"
        },
        "prev": {
          "$ref": "#/definitions/Link"
        }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "method"
      ],
      "properties": {
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "PATCH",
            "POST"
          ]
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}