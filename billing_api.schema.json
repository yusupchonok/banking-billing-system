{
  "title": "Banking Billing System API Schema",
  "type": "object",
  "definitions": {
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "method"
      ],
      "properties": {
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Ссылка на доступное действие"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "PATCH"
          ],
          "description": "HTTP-метод для перехода по ссылке"
        }
      }
    },
    "BillingOperationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalOperationId",
        "clientId",
        "accountId",
        "operationType",
        "operationAmount",
        "operationCurrency",
        "operationDate"
      ],
      "properties": {
        "externalOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Идентификатор денежной операции во внешней системе"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Идентификатор клиента"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Идентификатор счёта"
        },
        "operationType": {
          "type": "string",
          "enum": [
            "TRANSFER",
            "PAYMENT",
            "CASH_WITHDRAWAL"
          ],
          "description": "Тип денежной операции"
        },
        "operationAmount": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 999999999999.99,
          "multipleOf": 0.01,
          "description": "Сумма операции"
        },
        "operationCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3,
          "description": "Валюта операции в трёхбуквенном формате"
        },
        "operationDate": {
          "type": "string",
          "format": "date-time",
          "description": "Дата и время операции"
        }
      }
    },
    "BillingOperationPatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferStatus"
      ],
      "properties": {
        "transferStatus": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ],
          "description": "Результат выполнения денежной операции"
        }
      }
    },
    "BillingOperationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "externalOperationId",
        "status",
        "billingDecision",
        "commissionAmount",
        "commissionCurrency",
        "chargeStatus",
        "_links"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Идентификатор биллинговой операции"
        },
        "externalOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Идентификатор исходной денежной операции"
        },
        "status": {
          "type": "string",
          "enum": [
            "CALCULATED",
            "REJECTED",
            "COMPLETED",
            "CANCELLED",
            "ERROR"
          ],
          "description": "Статус биллинговой операции"
        },
        "billingDecision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ],
          "description": "Можно ли продолжать денежную операцию"
        },
        "decisionReason": {
          "type": "string",
          "enum": [
            "INSUFFICIENT_FUNDS",
            "ACCOUNT_BLOCKED",
            "ACCOUNT_CLOSED",
            "TARIFF_NOT_FOUND"
          ],
          "description": "Причина отказа"
        },
        "commissionAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 999999999999.99,
          "multipleOf": 0.01,
          "description": "Размер комиссии"
        },
        "commissionCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3,
          "description": "Валюта комиссии"
        },
        "chargeStatus": {
          "type": "string",
          "enum": [
            "NO_CHARGE",
            "RESERVED",
            "PAID",
            "NOT_CHARGED",
            "PAYMENT_ERROR"
          ],
          "description": "Статус работы с комиссией"
        },
        "_links": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "additionalProperties": {
            "$ref": "#/definitions/Link"
          },
          "description": "Доступные действия с ресурсом"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Код ошибки"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Описание ошибки"
        }
      }
    }
  }
}