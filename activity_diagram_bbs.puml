@startuml
title Banking Billing System — расчёт комиссии, подтверждение перевода и уведомления

|Клиент банка|
start
:Ввести параметры перевода;

|Система денежных переводов|
:POST /api/v1/billing-operations
Передать параметры операции
и Idempotency-Key;

|Banking Billing System|
:Проверить входные данные
и Idempotency-Key;

if (Запрос корректен?) then (Нет)
  :Вернуть HTTP 400 / 409;
  |Система денежных переводов|
  :Показать ошибку;
  stop
else (Да)
endif

|Banking Billing System|
:Определить действующий тариф;

if (Тариф найден?) then (Нет)
  :Вернуть HTTP 422
  TARIFF_NOT_FOUND;
  |Система денежных переводов|
  :Не продолжать перевод;
  stop
else (Да)
endif

|Banking Billing System|
:Получить клиентские условия;
:Рассчитать комиссию;
:Сохранить предварительный расчёт
в billing_operation;

if (Сумма комиссии = 0?) then (Да)
  :Установить
  billingDecision = APPROVED;
else (Нет)
  :Запросить в АБС
  возможность списания комиссии;

  |АБС|
  :Проверить состояние счёта
  и доступность средств;
  :Вернуть результат;

  |Banking Billing System|
  if (Списание возможно?) then (Да)
    :Установить
    billingDecision = APPROVED;
  else (Нет)
    :Установить
    billingDecision = REJECTED;
  endif
endif

:Сохранить результат расчёта;
:Вернуть operationId,
commissionAmount,
commissionCurrency,
billingDecision;

|Система денежных переводов|
if (billingDecision = APPROVED?) then (Нет)
  :Не выполнять перевод;
  |Клиент банка|
  :Получить отказ;
  stop
else (Да)
endif

:Показать сумму перевода
и рассчитанную комиссию;

|Клиент банка|
if (Подтвердить перевод?) then (Нет)
  :Отказаться от операции;

  |Система денежных переводов|
  :PATCH /api/v1/billing-operations/{operationId}
  transferStatus = CANCELLED
  If-Match;

  |Banking Billing System|
  :Проверить If-Match
  и состояние операции;

  if (Операцию можно изменить?) then (Нет)
    :Вернуть HTTP 412 / 423 / 428;
    |Система денежных переводов|
    :Обработать ошибку;
    stop
  else (Да)
    :Установить статус операции CANCELLED;
    :Комиссию не списывать;
    :Не создавать outbox_event;
    :Вернуть HTTP 200;
  endif

  |Система денежных переводов|
  :Не выполнять перевод;
  stop
else (Да)
endif

|Система денежных переводов|
:Выполнить денежный перевод;

if (Перевод успешен?) then (Да)
  :PATCH /api/v1/billing-operations/{operationId}
  transferStatus = COMPLETED
  If-Match;

  |Banking Billing System|
  :Проверить If-Match
  и состояние операции;

  if (Сумма комиссии = 0?) then (Да)
    :Завершить операцию
    без списания комиссии;
    :Вернуть HTTP 200;
    |Система денежных переводов|
    :Получить подтверждение;
    stop
  else (Нет)
    :Сформировать начисление
    billing.charge
    из предварительного расчёта;

    repeat
      :Передать распоряжение
      на списание комиссии в АБС;
      |АБС|
      :Выполнить списание;
      :Вернуть результат;
      |Banking Billing System|
    repeat while (Техническая ошибка
    AND не достигнут настроенный
    лимит попыток?) is (Да)
    ->Нет;

    if (Списание выполнено?) then (Да)
      :Установить charge.status = PAID;
      :В одной транзакции:
      сохранить итоговый статус
      и создать outbox_event
      COMMISSION_PAID;

      fork
        :Вернуть HTTP 200;
      fork again
        |Billing Worker / Event Publisher|
        :Получить NEW-событие;
        :Опубликовать в
        billing.notification-events;

        |Kafka|
        :Сохранить сообщение
        и передать подписчику;

        |Система уведомлений|
        :Получить COMMISSION_PAID;
        :Дедупликация по eventId;
        :Получить контакты
        по clientId;
        :Отправить уведомление;

        |Billing Worker / Event Publisher|
        :Перевести outbox_event
        в PUBLISHED;
      end fork

      |Система денежных переводов|
      stop
    else (Нет)
      :Установить charge.status = FAILED;
      :В одной транзакции:
      сохранить итоговый статус
      и создать outbox_event
      COMMISSION_FAILED;

      fork
        :Вернуть HTTP 503 / 504;
      fork again
        |Billing Worker / Event Publisher|
        :Получить NEW-событие;
        :Опубликовать в
        billing.notification-events;

        |Kafka|
        :Сохранить сообщение
        и передать подписчику;

        |Система уведомлений|
        :Получить COMMISSION_FAILED;
        :Дедупликация по eventId;
        :Получить контакты
        по clientId;
        :Отправить уведомление
        об ошибке списания;

        |Billing Worker / Event Publisher|
        :Перевести outbox_event
        в PUBLISHED;
      end fork

      |Система денежных переводов|
      stop
    endif
  endif

else (Нет)
  :PATCH /api/v1/billing-operations/{operationId}
  transferStatus = FAILED
  If-Match;

  |Banking Billing System|
  :Зафиксировать неуспешный
  результат перевода;
  :Комиссию не списывать;
  :Вернуть HTTP 200;

  |Система денежных переводов|
  :Завершить процесс
  без списания комиссии;
  stop
endif

@enduml
