@startuml
title Banking Billing System — обработка биллингового события
|Система переводов|
start
:Сформировать биллинговое событие;
:Передать событие в Billing System;
|Banking Billing System|
:Принять событие;
if (Данные корректны?) then (да)
else (нет)
  :Сохранить ошибку валидации;
  |Система переводов|
  :Получить отказ;
  end
endif
|Banking Billing System|
if (Событие уже обработано?) then (да)
  :Получить сохранённый результат;
  |Система переводов|
  :Получить ранее сформированный результат;
  stop
else (нет)
endif
fork
  |Сервис тарифов|
  repeat
    :Найти тариф на дату операции;
  repeat while (Сервис недоступен и\nпопыток меньше 3?) is (да) not (нет)
  |Banking Billing System|
  :Получить результат поиска тарифа;
fork again
  |Banking Billing System|
  :Получить скидки и лимиты клиента;
end fork
|Banking Billing System|
if (Ответ сервиса тарифов получен?) then (да)
else (нет)
  :Сохранить техническую ошибку;
  |Система переводов|
  :Получить статус "Ошибка обработки";
  end
endif
|Banking Billing System|
if (Активный тариф найден?) then (да)
else (нет)
  :Сохранить ошибку "Тариф не найден";
  |Система переводов|
  :Получить отказ в расчёте;
  end
endif
|Banking Billing System|
:Рассчитать комиссию;
:Применить скидки, лимиты\nи правила округления;
if (Расчёт выполнен успешно?) then (да)
else (нет)
  :Сохранить ошибку расчёта;
  |Система переводов|
  :Получить отказ в расчёте;
  end
endif
|Banking Billing System|
:Создать и сохранить начисление;
if (Начисление сохранено?) then (да)
else (нет)
  :Сохранить техническую ошибку;
  |Система переводов|
  :Получить статус "Ошибка обработки";
  end
endif
|Banking Billing System|
if (Сумма комиссии равна 0?) then (да)
  :Установить статус "Без комиссии";
else (нет)
  repeat
    |АБС|
    :Попытаться списать комиссию;
    |Banking Billing System|
    :Получить результат списания;
  repeat while (Техническая ошибка и\nпопыток меньше 3?) is (да) not (нет)
  if (Результат списания?) then (успешно)
    :Установить статус "Оплачено";
  elseif (Недостаточно средств) then (да)
    :Установить статус "Ожидает оплаты";
  elseif (Счёт заблокирован или закрыт) then (да)
    :Установить статус "Списание отклонено";
  else (ответ не получен)
    :Установить статус "Ошибка списания";
  endif
endif
fork
  :Сохранить итоговый статус;
fork again
  |Система переводов|
  :Получить результат обработки;
end fork
|Banking Billing System|
stop
@enduml