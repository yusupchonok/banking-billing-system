@startuml
title Banking Billing System

|Система денежных переводов|
start
:Опубликовать событие TRANSFER_COMPLETED
в Kafka topic transfer.completed;

|Banking Billing System|
:Считать событие из
transfer.completed;
:Проверить корректность
входных данных;

if (Данные корректны?) then (Нет)
  :Сохранить статус INVALID_DATA
  в таблицу billing_event;
  :Опубликовать результат
  в Kafka topic billing.result;
  |Система денежных переводов|
  :Получить результат INVALID_DATA;
  end
else (Да)
endif

|Banking Billing System|
:Проверить eventId
в таблице billing_event;

if (Событие уже обработано?) then (Да)
  :Получить ранее сохранённый результат
  из таблицы billing_event;
  :Опубликовать результат
  в Kafka topic billing.result;
  |Система денежных переводов|
  :Получить предыдущий результат;
  stop
else (Нет)
endif

fork
  |Banking Billing System|
  repeat
    :GET /api/v1/tariffs
    Получение применимого тарифа
    на дату операции;
    |Сервис тарифов|
    :Найти тариф
    по параметрам операции;
    :Вернуть HTTP-ответ;
    |Banking Billing System|
  repeat while (HTTP 5xx / timeout
  AND Retry count < 3?) is (Да)
  ->Нет;

  if (HTTP 200?) then (Да)
    :Получить параметры тарифа;
  elseif (HTTP 404?) then (Да)
    :Результат TARIFF_NOT_FOUND;
  else (HTTP 5xx / timeout)
    :Результат TECHNICAL_ERROR;
  endif

fork again
  |Banking Billing System|
  repeat
    :GET /api/v1/clients/{clientId}/billing-context
    Получение скидок и лимитов клиента;
    |Сервис клиентских данных|
    :Сформировать клиентский
    биллинговый контекст;
    :Вернуть HTTP-ответ;
    |Banking Billing System|
  repeat while (HTTP 5xx / timeout
  AND Retry count < 3?) is (Да)
  ->Нет;

  if (HTTP 200?) then (Да)
    :Получить скидки и лимиты;
  elseif (HTTP 404?) then (Да)
    :Расчёт без
    персональных условий;
  else (HTTP 5xx / timeout)
    :Результат TECHNICAL_ERROR;
  endif
end fork

|Banking Billing System|
if (Получен TECHNICAL_ERROR?) then (Да)
  :Сохранить статус TECHNICAL_ERROR
  в таблицу billing_event;
  :Опубликовать результат
  в Kafka topic billing.result;
  |Система денежных переводов|
  :Получить ошибку обработки;
  end
else (Нет)
endif

|Banking Billing System|
if (Получен TARIFF_NOT_FOUND?) then (Да)
  :Сохранить статус TARIFF_NOT_FOUND
  в таблицу billing_event;
  :Опубликовать результат
  в Kafka topic billing.result;
  |Система денежных переводов|
  :Получить результат TARIFF_NOT_FOUND;
  end
else (Нет)
endif

|Banking Billing System|
:Рассчитать комиссию;
:Применить скидки, лимиты
и правила округления;

if (Расчёт выполнен?) then (Нет)
  :Сохранить статус CALCULATION_ERROR
  в таблицу billing_event;
  :Опубликовать результат
  в Kafka topic billing.result;
  |Система денежных переводов|
  :Получить ошибку расчёта;
  end
else (Да)
endif

|Banking Billing System|
:Сохранить начисление
в таблицу billing_charge;

if (Сумма комиссии = 0?) then (Да)
  :Установить статус NO_CHARGE;
else (Нет)
  repeat
    :POST /api/v1/debits
    Создание запроса
    на списание комиссии;
    |АБС|
    :Проверить счёт
    и выполнить списание;
    :Вернуть HTTP-ответ
    и businessCode;
    |Banking Billing System|
  repeat while (HTTP 5xx / timeout
  AND Retry count < 3?) is (Да)
  ->Нет;

  if (HTTP 200?) then (Да)
    :Статус PAID;
  elseif (HTTP 422
  INSUFFICIENT_FUNDS?) then (Да)
    :Статус PAYMENT_PENDING;
  elseif (HTTP 422
  ACCOUNT_BLOCKED / ACCOUNT_CLOSED?) then (Да)
    :Статус PAYMENT_REJECTED;
  else (HTTP 5xx / timeout)
    :Статус PAYMENT_ERROR;
  endif
endif

|Banking Billing System|
:Сохранить итоговый статус
в таблицу billing_charge;
:Опубликовать результат
в Kafka topic billing.result;

|Система денежных переводов|
:Получить итоговый результат;
stop

@enduml
